spritelayout spritelayout_flag(orientation,flag,frame) {
    ground { sprite: GROUNDSPRITE_NORMAL; }
    building { sprite: spriteset_tower();
				zextent: 70;
				xoffset: 2;
				yoffset: 2;
				yextent: 12;
				xextent: 12;}
	childsprite {
	sprite: spriteset_hanger(orientation);

	}
	childsprite {
	sprite: spriteset_flags(flag*2 + frame*34+orientation % 2);
	}
	childsprite {
	sprite: spriteset_spinner(frame/3 % 2);
	}
}

spritelayout spritelayout_flag_purchase(orientation,flag) {
    ground { sprite: spriteset_empty; }
    building { sprite: spriteset_tower();
				zextent: 70;
				zoffset: -16;
				xoffset: 2;
				yoffset: 2;
				yextent: 12;
				xextent: 12;}
	childsprite {
	sprite: spriteset_hanger(orientation);

	}
	childsprite {
	sprite: spriteset_flags(flag*2 + orientation % 2);
	}
	childsprite {
	sprite: spriteset_spinner(0);
	}
}

//ITEMS

item (FEAT_OBJECTS, object_banner0) {
	property {
		class:                  "FBN2";
		classname:              string(STR_FBN2);
		name:                   string(STR_OBJ_flag0);
		climates_available:     ALL_CLIMATES;
		size:                   [1, 1];
		build_cost_multiplier:  2;
		remove_cost_multiplier: 2;
		introduction_date:      0x00000000;
		end_of_life_date:       0xFFFFFFFF;
		object_flags:           bitmask(OBJ_FLAG_ANIMATED);
		animation_info:			[ANIMATION_LOOPING,17];
		animation_speed:		2;
		animation_triggers:		ANIM_TRIGGER_OBJ_256_TICKS;
		num_views:              2;
	}
	graphics {
		default:         spritelayout_flag(view,0,animation_frame);
		purchase:        spritelayout_flag_purchase(view,0);
		anim_control:	return 1;
		anim_next_frame:return (animation_frame==0) ? CB_RESULT_STOP_ANIMATION : CB_RESULT_NEXT_FRAME;
		additional_text:string(STR_ADD_0);
	}
}

